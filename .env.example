# ─── Обязательно для docker compose ─────────────────────────────
POSTGRES_PASSWORD=change-me
AUDIT_API_TOKEN=

# ─── LLM-провайдер (один из двух; без них аудит отвечает 503) ──
# Yandex Cloud (по умолчанию). API_KEY — секретное значение ключа.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER=
#YANDEX_CLOUD_MODEL=qwen3.6-35b-a3b/latest

# AnyModel (приоритет над Yandex, когда задан). MODEL — сырой id из GET /v1/models.
#ANYMODEL_API_KEY=
#ANYMODEL_MODEL=ds/deepseek-v4-flash

# ─── Доступ по сети (по умолчанию — только localhost) ───────────
# Интранет: IP или имя сервера в LAN, порт наружу на всех интерфейсах.
#NUXT_PUBLIC_HOST=192.168.1.10
#WORKSPACE_BIND=0.0.0.0
# Мировая сеть: домен + общий пароль + TLS-терминация выше (reverse proxy).
#NUXT_PUBLIC_HOST=audit.example.com
#WORKSPACE_PASSWORD=
#WORKSPACE_BIND=0.0.0.0
#WORKSPACE_PORT=3000
#
# ─── Необязательно ──────────────────────────────────────────────
# PostgreSQL и порты (значения по умолчанию ниже).
#POSTGRES_USER=smeta
#POSTGRES_DB=smeta
#API_PORT=8000

# Трейсинг Langfuse (пустые ключи = выключен).
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_ENVIRONMENT=development

# Тонкая настройка (значения по умолчанию; раскомментируйте для переопределения).
#ANYMODEL_BASE_URL=https://anymodel.org/v1
#AUDIT_ALLOWED_LLM_HOSTS=ai.api.cloud.yandex.net  # хост выбранного ANYMODEL_BASE_URL доверяется автоматически
#AUDIT_LLM_INPUT_COST_PER_1K=0
#AUDIT_LLM_OUTPUT_COST_PER_1K=0
#AUDIT_LLM_CONCURRENCY=2
#AUDIT_MAX_UPLOAD_BYTES=104857600
#AUDIT_MAX_UPLOADS_PER_REQUEST=32
#AUDIT_PDF_CONCURRENCY=2
#AUDIT_TASK_SOFT_TIME_LIMIT=540
#AUDIT_TASK_TIME_LIMIT=600
#AUDIT_TELEMETRY_MASK_PROMPTS=0
#AUDIT_TELEMETRY_REDACT_PDF=0
#TESSDATA_PREFIX=
